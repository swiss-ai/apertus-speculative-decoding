+    def _walk_language_model(self):
+        """Apertus 1.5 is ``*ForConditionalGeneration`` with ``language_model``.
+
+        Do not relabel the target as Llama. Prefer the language-model submodule
+        before the generic ``.model.layers`` walk used by Llama-style LMs.
+        """
+        model = self.model
+        if hasattr(model, "language_model"):
+            return model.language_model
+        inner = getattr(model, "model", None)
+        if inner is not None and hasattr(inner, "language_model"):
+            return inner.language_model
+        return inner if inner is not None else model
