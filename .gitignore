.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
.idea/
.vscode/

# Local credentials and scratch output. Canonical experiment results belong in results/.
.env
scratch/

# Restricted source text; commit only manifest.json.
workloads/8b/*.jsonl
# Restricted source text (SFT-mix prompts/answers, served captures of them).
results/70b/eagle/data/*.jsonl
results/70b/eagle/data/torchspec/
results/70b/eagle/preflight/mix-text-by-id.json
results/8b/eagle/serving-smoke/*/capture-prompts.jsonl
results/8b/eagle/serving-smoke/*/capture.json
results/8b/eagle/data-mix*/

# Nsight Systems reports and their SQLite exports stay on the cluster; a sweep
# record keeps the nsys-stats/ CSVs and manifest (docs/waste-profiling.md).
*.nsys-rep
*.qdstrm
results/**/nsys/

# Restricted token-level continuations retained locally and on Clariden.
results/8b/tree-drafters/screen-20261024/raw/*/captures/
results/8b/tree-drafters/screen-20261024/raw/*/candidates/*.jsonl.gz

# Greedy captures declared in a sweep spec keep full output text; on SFT-mix or
# finepdfs prompts that is restricted, so they stay on the cluster.
results/8b/sweeps/*/*/capture-*.json
