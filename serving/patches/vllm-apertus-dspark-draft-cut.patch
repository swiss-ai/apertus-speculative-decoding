+    def _best(self, rows: list[np.ndarray], num_reqs: int, draft_len: int | None):
+        """(Theta, K) of Algorithm 1's admission path over the given slots."""
+        if rows:
+            survival = np.sort(np.concatenate(rows))[::-1]
+        else:
+            survival = np.zeros(0)
+        admitted = np.arange(len(survival) + 1)
+        tau = num_reqs + np.concatenate(([0.0], np.cumsum(survival)))
+        theta = tau / np.maximum(
+            self.step_ms(num_reqs + admitted, num_reqs, draft_len), 1e-6
+        )
+        best = int(np.argmax(theta))
+        return float(theta[best]), best
+
+    def plan(
