+    def _extended_rows(self, scheduled_spec: dict[str, list[int]]) -> list[np.ndarray]:
+        """Survival of every scheduled slot: the newest observed values where
+        the request's last draft produced them (positive), extrapolated with
+        the running conditional confidence per slot beyond."""
+        rows = []
+        for req_id, tokens in scheduled_spec.items():
+            length = len(tokens)
+            row = self.survival.get(req_id)
+            out = np.empty(length)
+            known = 0
+            if row is not None:
+                positive = row[:length] > 0
+                known = length if positive.all() else int(np.argmin(positive))
+                out[:known] = row[:known]
+            last = out[known - 1] if known else 1.0
+            for slot in range(known, length):
+                last *= self.conditional[slot]
+                out[slot] = last
+            rows.append(out)
+        return rows
