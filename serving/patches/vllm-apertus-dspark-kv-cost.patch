+    def _profile_dspark_kv_read(self, timed) -> dict[str, float]:
+        """Per-step cost of one context token's KV, which the short-context
+        dummy batches miss: decode attention streams each request's whole
+        context once per step, so a token costs the target's KV bytes per
+        token over the HBM read bandwidth (a 1 GiB reduction, timed)."""
+        layers = self.model_config.get_num_layers(self.parallel_config)
+        kv_heads = self.model_config.get_num_kv_heads(self.parallel_config)
+        head_size = self.model_config.get_head_size()
+        element_size = self.kv_cache_dtype.itemsize
+        bytes_per_token = 2 * layers * kv_heads * head_size * element_size
+        buffer = torch.ones(1 << 28, dtype=torch.float32, device=self.device)
+        read_ms = timed(lambda: buffer.sum())
+        read_bytes_per_ms = buffer.numel() * buffer.element_size() / read_ms
+        del buffer
+        return {
+            "kv_ms_per_token": bytes_per_token / read_bytes_per_ms,
+            "kv_bytes_per_token": bytes_per_token,
+            "hbm_read_gb_per_s": read_bytes_per_ms * 1000.0 / 1e9,
+        }
+
