+class ConfidenceVerifyScheduler:
+    """Per-request verification lengths for DSpark from its confidence head.
+
+    Follows confidence-scheduled verification (DSpark, arXiv:2607.05147): with
+    ``a[r, j]`` the prefix survival of draft slot ``j`` of request ``r`` (the
+    running product of per-slot acceptance probabilities), verifying ``l_r``
+    slots per request yields ``tau = sum_r (1 + sum_{j < l_r} a[r, j])``
+    expected tokens and costs a forward pass over ``B = B0 + sum_r (1 + l_r)``
+    tokens. ``greedy`` admits slots by descending survival and keeps the prefix
+    that maximises ``(P + tau) / step_time(B)``; ``threshold`` keeps the slots
+    whose survival is at least VLLM_DSPARK_VERIFY_THRESHOLD.
+
+    ``P`` is the prefill tokens expected in the same step. The paper maximises
+    ``tau`` alone on a decode-only engine; here prefill shares the forward pass,
+    and draft slots that lengthen the step delay that prefill as well, so the
+    objective is all tokens processed per second. Without prefill it is the
+    paper's.
+
+    The step time is ``f(B) + overhead``: ``f`` is a profile of forward-pass
+    time against batch tokens at short contexts (JSON ``{"tokens": [...],
+    "step_ms": [...]}`` from VLLM_DSPARK_VERIFY_PROFILE), and ``overhead`` is
+    learned online as the mean excess of the observed step interval over
+    ``f`` (attention over long contexts, drafting, scheduling). ``B0`` counts
+    the prefill tokens expected in the step (a running mean) and the slots of
+    requests without a survival estimate yet.
+
+    With VLLM_DSPARK_VERIFY_UNIFORM=1 every decode request in the step gets
+    the same length (the one maximising the same objective over the batch):
+    a batch whose requests verify different numbers of tokens is not a
+    uniform decode batch and runs with piecewise instead of full CUDA graphs.
+
+    The survival of a request's drafts reaches the scheduler with the output
+    of the step that drafted them. Without async scheduling that is before the
+    step verifying them is scheduled; with it, one step later, so the lengths
+    come from the request's previous drafts.
+    """
+
+    def __init__(
+        self,
+        mode: str,
+        threshold: float,
+        profile_tokens: list[float] | None,
+        profile_ms: list[float] | None,
+        log_every: int = 500,
+        uniform: bool = False,
+    ) -> None:
+        if mode not in ("greedy", "threshold"):
+            raise ValueError(f"VLLM_DSPARK_VERIFY_MODE must be greedy or threshold, got {mode}")
+        self.mode = mode
+        self.threshold = threshold
+        self.uniform = uniform
+        if uniform and mode != "greedy":
+            raise ValueError("VLLM_DSPARK_VERIFY_UNIFORM needs the greedy mode")
+        if mode == "greedy":
+            if not profile_tokens or len(profile_tokens) != len(profile_ms or ()):
+                raise ValueError("greedy verification needs VLLM_DSPARK_VERIFY_PROFILE")
+            order = np.argsort(profile_tokens)
+            self.tokens = np.asarray(profile_tokens, dtype=np.float64)[order]
+            self.ms = np.asarray(profile_ms, dtype=np.float64)[order]
+            if len(self.tokens) >= 2:
+                self.slope = (self.ms[-1] - self.ms[-2]) / max(
+                    self.tokens[-1] - self.tokens[-2], 1.0
+                )
+            else:
+                self.slope = 0.0
+        self.survival: dict[str, np.ndarray] = {}
+        self.overhead_ms = 0.0
+        self.prefill_tokens = 0.0
+        self._last_output_time: float | None = None
+        self.log_every = log_every
+        self._steps = 0
+        self._sum_len = 0.0
+        self._sum_reqs = 0
+
+    @classmethod
+    def from_env(cls) -> "ConfidenceVerifyScheduler":
+        mode = os.environ.get("VLLM_DSPARK_VERIFY_MODE", "greedy")
+        threshold = float(os.environ.get("VLLM_DSPARK_VERIFY_THRESHOLD", "0.5"))
+        tokens = ms = None
+        path = os.environ.get("VLLM_DSPARK_VERIFY_PROFILE")
+        if path:
+            with open(path) as handle:
+                profile = json.load(handle)
+            tokens, ms = profile["tokens"], profile["step_ms"]
+        uniform = os.environ.get("VLLM_DSPARK_VERIFY_UNIFORM", "0") == "1"
+        scheduler = cls(mode, threshold, tokens, ms, uniform=uniform)
+        logger.info(
+            "DSpark confidence-scheduled verification: mode=%s threshold=%s "
+            "uniform=%s profile=%s",
+            mode,
+            threshold,
+            uniform,
+            path,
+        )
+        return scheduler
+
+    def step_ms(self, num_tokens: np.ndarray) -> np.ndarray:
+        num_tokens = np.asarray(num_tokens, dtype=np.float64)
+        ms = np.interp(num_tokens, self.tokens, self.ms)
+        above = num_tokens > self.tokens[-1]
+        ms[above] = self.ms[-1] + (num_tokens[above] - self.tokens[-1]) * self.slope
+        return ms
+
+    def lengths(
+        self, rows: list[np.ndarray], num_decode: int, num_unscored: int
+    ) -> np.ndarray:
+        """Verification length per scored request (``rows`` hold the prefix
+        survival of each request's draft slots, non-increasing)."""
+        sizes = np.fromiter((len(row) for row in rows), dtype=np.int64, count=len(rows))
+        survival = np.concatenate(rows).astype(np.float64)
+        owner = np.repeat(np.arange(len(rows)), sizes)
+        if self.mode == "threshold":
+            return np.bincount(owner[survival >= self.threshold], minlength=len(rows))
+        if self.uniform:
+            return np.full(len(rows), self._uniform_length(rows, num_decode, num_unscored))
+        position = np.concatenate([np.arange(size) for size in sizes])
+        # Highest survival first; ties keep slot order, so each request gets
+        # a prefix of its draft.
+        order = np.lexsort((position, -survival))
+        gain = np.concatenate(([0.0], np.cumsum(survival[order])))
+        admitted = np.arange(len(order) + 1)
+        base_tokens = self.prefill_tokens + num_decode + num_unscored
+        # Unscored slots (no estimate yet) are verified anyway: count them at
+        # the mean survival of the scored ones.
+        expected = (
+            self.prefill_tokens + num_decode + num_unscored * float(survival.mean()) + gain
+        )
+        cost = np.maximum(self.step_ms(base_tokens + admitted) + self.overhead_ms, 1e-3)
+        best = int(np.argmax(expected / cost))
+        return np.bincount(owner[order[:best]], minlength=len(rows))
+
+    def _uniform_length(
+        self, rows: list[np.ndarray], num_decode: int, num_unscored: int
+    ) -> int:
+        """One length for every decode request of the step."""
+        width = max(len(row) for row in rows)
+        table = np.zeros((len(rows), width))
+        for index, row in enumerate(rows):
+            table[index, : len(row)] = row
+        gain = np.concatenate(([0.0], np.cumsum(table.sum(axis=0))))
+        lengths = np.arange(width + 1)
+        # Unscored requests are trimmed to the same length; count their slots
+        # at the mean survival per position.
+        if num_unscored:
+            gain = gain * (1.0 + (num_decode - len(rows)) / max(len(rows), 1))
+        expected = self.prefill_tokens + num_decode + gain
+        cost = np.maximum(
+            self.step_ms(self.prefill_tokens + num_decode * (1 + lengths)) + self.overhead_ms,
+            1e-3,
+        )
+        return int(np.argmax(expected / cost))
+
+    def assign(self, running: list[Request]) -> None:
+        """Trim the draft placeholders of running decode requests to their
+        verification length before the step is scheduled."""
+        scored: list[Request] = []
+        rows: list[np.ndarray] = []
+        num_decode = 0
+        num_unscored = 0
+        for request in running:
+            if request.is_prefill_chunk:
+                continue
+            num_decode += 1
+            num_slots = len(request.spec_token_ids)
+            if num_slots == 0:
+                continue
+            row = self.survival.get(request.request_id)
+            if row is None:
+                num_unscored += num_slots
+                continue
+            scored.append(request)
+            rows.append(row[:num_slots])
+        if len(self.survival) > 2 * len(running) + 64:
+            live = {request.request_id for request in running}
+            self.survival = {k: v for k, v in self.survival.items() if k in live}
+        if not scored:
+            return
+        lengths = self.lengths(rows, num_decode, num_unscored)
+        for request, length in zip(scored, lengths.tolist()):
+            if length < len(request.spec_token_ids):
+                request.spec_token_ids = request.spec_token_ids[:length]
+        if self.uniform and len(lengths):
+            # Requests without an estimate yet get the same length, so the
+            # batch stays uniform.
+            length = int(lengths[0])
+            for request in running:
+                if not request.is_prefill_chunk and len(request.spec_token_ids) > length:
+                    request.spec_token_ids = request.spec_token_ids[:length]
+        self._steps += 1
+        self._sum_len += float(lengths.sum())
+        self._sum_reqs += len(scored)
+        if self._steps % self.log_every == 0:
+            logger.info(
+                "DSpark verification: mean length %.2f over %d steps, "
+                "step overhead %.2f ms, prefill tokens per step %.0f",
+                self._sum_len / max(self._sum_reqs, 1),
+                self.log_every,
+                self.overhead_ms,
+                self.prefill_tokens,
+            )
+            self._sum_len = 0.0
+            self._sum_reqs = 0
+
+    def observe(
+        self, scheduler_output: SchedulerOutput, model_runner_output: ModelRunnerOutput
+    ) -> None:
+        """Record the drafts' survival and update the step-time model."""
+        survival = model_runner_output.spec_survival
+        if survival is not None:
+            for index, req_id in enumerate(model_runner_output.req_ids):
