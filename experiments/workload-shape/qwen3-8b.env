# Settings of the Qwen3-8B + Red Hat EAGLE-3 / DFlash workload-shape run (job 4052231;
# the run sourced results/qwen3-8b/workload-shape/inputs/qwen-env.sh, which these repeat).
#   set -a; . experiments/workload-shape/qwen3-8b.env; set +a
#   experiments/workload-shape/submit-shape.sh RUN_DIR
# Paths are on Clariden scratch (downloads: job 4051595, pinned revisions, SHA256SUMS).
Q=/iopsstor/scratch/cscs/faruk_zahiragic/workload-shape-qwen3-8b
SHAPE_ENV_SOURCE=experiments/workload-shape/env-qwen3.toml
SHAPE_JOB_NAME=shape-qwen3-8b
SML_ENV_DIR=${Q}/sml-env
APERTUS_EAGLE_CONTRACT=targets/qwen3-8b/contract.json
TARGET=${Q}/models/Qwen--Qwen3-8B
EAGLE_HEAD=${Q}/models/RedHatAI--Qwen3-8B-speculator.eagle3
DSPARK=${Q}/models/RedHatAI--Qwen3-8B-speculator.dflash
# The frozen corpus, copied from the Apertus run's inputs and checked against its digest.
CORPUS_FROM=/iopsstor/scratch/cscs/faruk_zahiragic/workload-shape/runs/full-20261122/inputs
# Speculators heads: EAGLE-3 (reduced draft vocabulary) and DFlash (block 16, 15 drafts);
# DFlash aux ids [2, 10, 18, 26, 34] = after HF decoder layers 1, 9, 17, 25, 33; both
# heads use their stored embedding / LM head, as vLLM's loaders do.
SHAPE_ARGS="--eagle-format speculators --block-format dflash --names dflash,eagle3 --depth 15 --dspark-hf-layers 1,9,17,25,33 --dspark-own-vocab"
AGG_ARGS="--sampled"
HF_HOME=${Q}/hf_home
TREE_PYDEPS=/users/faruk_zahiragic/apertus-spec-decoding/scratch/pydeps:${Q}/pydeps
PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
# Served gate (job 4052232): experiments/workload-shape/submit-gate.sh GATE_DIR CORPUS.
# GPU lanes: 0 EAGLE-3 k=3, 1 DFlash k=3, 2 DFlash k=15 (the card's k), 3 the T=1 arms.
GATE_TARGET=${TARGET}
GATE_TARGET_ID=Qwen/Qwen3-8B
GATE_TARGET_REV=b968826d9c46dd6066d109eabc6255188de91218
GATE_HEADS="eagle3:${EAGLE_HEAD}:RedHatAI/Qwen3-8B-speculator.eagle3:08610ffa01dd9f16731fe8f627b85905b6aa51c4 dflash:${DSPARK}:RedHatAI/Qwen3-8B-speculator.dflash:1a11b170eb65c8a62c80ecd01dfe22a5907298e6"
GATE_ARMS="eagle3-k3:eagle3:3:greedy:0 dflash-k3:dflash:3:greedy:1 dflash-k15:dflash:15:greedy:2 eagle3-k3-t1:eagle3:3:t1:3 dflash-k3-t1:dflash:3:t1:3"
GATE_SERVED_PREFIX=qwen3-8b
GATE_JOB_NAME=shape-gate-qwen3-8b
GATE_MAX_MODEL_LEN=32768
GATE_TIME=04:00:00
