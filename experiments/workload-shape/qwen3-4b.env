# Settings of the Qwen3-4B + Red Hat DSpark workload-shape run (job 4052179).
#   set -a; . experiments/workload-shape/qwen3-4b.env; set +a
#   experiments/workload-shape/submit-shape.sh RUN_DIR
# Paths are on Clariden scratch (downloads: job 4051559, pinned revisions, SHA256SUMS).
Q=/iopsstor/scratch/cscs/faruk_zahiragic/workload-shape-qwen3-4b
SHAPE_ENV_SOURCE=experiments/workload-shape/env-qwen3.toml
SHAPE_JOB_NAME=workload-shape-q4b
APERTUS_EAGLE_CONTRACT=targets/qwen3-4b/contract.json
TARGET=${Q}/models/Qwen--Qwen3-4B
DSPARK=${Q}/models/RedHatAI--Qwen3-4B-speculator.dspark
# No EAGLE head for this target: DSpark-only study.
EAGLE_HEAD=
# Config aux ids [1, 9, 17, 25, 33] = after HF decoder layers 0, 8, 16, 24, 32. The
# checkpoint stores embed_tokens/lm_head; vLLM's loader uses them (--dspark-own-vocab).
SHAPE_ARGS="--dspark-hf-layers 0,8,16,24,32 --dspark-own-vocab"
# The T=1 sampled-drafting replay, chained in the shards' float32 as job 4052179 did.
AGG_ARGS="--sampled --sampled-dtype float32"
# Long-context prompts are 8.5k-24k tokens; Qwen3-4B's native context is 40,960.
MAX_MODEL_LEN=40960
# speculators e3041dd (git archive, plus hs_connectors and a dist-info stub) for the
# real-checkpoint logit test against DSparkDraftModel.
SPECULATORS_SRC=${Q}/speculators-e3041dd/src
SHAPE_REF_DSPARK=${DSPARK}
SHAPE_REF_TARGET=${TARGET}
HF_HOME=${Q}/hf_home
# Pure-Python wheels the vLLM 0.30 image lacks (accelerate for device_map, pytest);
# WHEELS-SHA256SUMS inside. The Apertus pydeps would shadow the image's protobuf.
TREE_PYDEPS=${Q}/pydeps
# Served gate (job 4052199): experiments/workload-shape/submit-gate.sh GATE_DIR CORPUS.
# One deployment per GPU: DSpark k=3 and k=7 (the head's default), greedy and T=1.
GATE_TARGET=${TARGET}
GATE_TARGET_ID=Qwen/Qwen3-4B
GATE_TARGET_REV=1cfa9a7208912126459214e8b04321603b3df60c
GATE_HEADS="dspark:${DSPARK}:RedHatAI/Qwen3-4B-speculator.dspark:bdffaa5f011da5a1a58ad841a1f6ced3e87f2f23"
GATE_ARMS="k3-greedy:dspark:3:greedy:0 k7-greedy:dspark:7:greedy:1 k3-t1:dspark:3:t1:2 k7-t1:dspark:7:t1:3"
GATE_SERVED_PREFIX=qwen3-4b-dspark
GATE_JOB_NAME=shape-gate-q4b
GATE_MAX_MODEL_LEN=40960
GATE_SERVE_ARGS="--seed 0"
GATE_BENCH_ARGS="--warmup-requests 1 --metrics-interval 5"
GATE_TIME=03:00:00
