        "output": "```python\nfrom typing import List, Tuple\n\ndef merge_intervals(intervals: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Merge overlapping closed intervals in a list of (start, end) tuples.\n\n    Args:\n        intervals: A list of closed intervals, each represented as (start, end).\n                  Assumed to be sorted by start value.\n\n    Returns:\n        A new list of merged intervals, sorted by start value.\n    \"\"\"\n    if not intervals:\n        return []\n\n    merged: List[Tuple[int, int]] = [intervals[0]]\n\n    for current_start, current_end in intervals[1:]:\n        last_start, last_end = merged[-1]\n\n        # Check if current interval overlaps with the last merged interval\n        if current_start <= last_end:\n            # Merge the intervals\n            new_start = last_start\n            new_end = max(last_end, current_end)\n            merged[-1] = (new_start, new_end)\n        else:\n            # No overlap, add the current interval\n            merged.append((current_start, current_end))\n\n    return merged\n\n\n# --- Tests ---\n\ndef test_merge_intervals():\n    assert merge_intervals([]) == []\n    assert merge_intervals([(1, 3), (4, 5)]) == [(1, 3), (4, 5)]\n    assert merge_intervals([(1, 5), (3, 7), (4, 6)]) == [(1, 7)]\n    assert merge_intervals([(1, 2), (2, 3), (3, 4)]) == [(1, 4)]\n    assert merge_intervals([(1, 4), (5, 6), (7, 9), (8, 10)]) ==",
