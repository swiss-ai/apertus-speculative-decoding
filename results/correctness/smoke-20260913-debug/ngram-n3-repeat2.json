        "output": "```rust\nuse std::collections::HashMap;\nuse std::str::Chars;\n\n/// Checks if brackets in a UTF-8 string are balanced.\n///\n/// Supports (), [], and {}.\n///\n/// Time complexity: O(n), where n is the length of the string.\n/// Space complexity: O(n) in the worst case (stack usage proportional to input size).\npub fn is_balanced(s: &str) -> bool {\n    let mut stack: Vec<char> = vec[];\n\n    let mut iter = s.chars();\n    let mut map = HashMap::from([\n        ('(', ')'),\n        ('[', ']'),\n        ('{', '}'),\n    ]);\n\n    while let Some(c) = iter.next() {\n        match c {\n            '(' | '[' | '{' => {\n                stack.push(c);\n            }\n            ')' | ']' | '}' => {\n                if stack.is_empty() {\n                    return false;\n                }\n                let top = stack.pop().unwrap();\n                if map.get(&top).unwrap() != &c {\n                    return false;\n                }\n            }\n            _ => {} // ignore non-bracket characters\n        }\n    }\n\n    stack.is_empty()\n}\n```\n\n### Explanation\n\n1. **Algorithm**:\n   - Use a stack to keep track of opening brackets.\n   - For each character in the string:\n     - If it's an opening bracket (`(`, `[`, `{`), push it onto the stack.\n     - If it's a closing bracket (`)`, `]`, `}`):\n       - If the stack is empty, return `false` (unmatched closing bracket).\n       - Pop the top of the stack and check if it matches the closing bracket using a lookup map.\n       - If they don't match, return `false`.\n   - After processing all characters, return `true` only if the stack is empty",
