+def output_vocab_size(model_config, text_config) -> int:
+    """Allocate the lm_head against the target's output support, not input vocab.
+
+    Apertus 1.5 (and other multimodal wrappers) keep ``text_config.vocab_size``
+    as the *input* vocabulary (embeddings, image/audio token ids) while the
+    physical ``lm_head.weight`` is ``[output_vocab_size, hidden]``. Using
+    ``vocab_size`` here makes ``copy_`` fail or silently pad the wrong rows.
+    Do not relabel the target as Llama to dodge this.
+    """
+    for cfg in (text_config, model_config):
+        value = getattr(cfg, "output_vocab_size", None)
+        if value:
+            return int(value)
+    return int(text_config.vocab_size)
+
+
 class _TargetRMSNorm(nn.Module):
     """Weight-only RMSNorm used when remote model construction is unavailable."""
 
