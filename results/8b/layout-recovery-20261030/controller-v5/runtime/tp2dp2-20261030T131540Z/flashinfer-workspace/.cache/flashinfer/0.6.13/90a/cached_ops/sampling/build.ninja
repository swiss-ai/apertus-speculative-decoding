ninja_required_version = 1.3
name = sampling
cuda_home = /usr/local/cuda
cxx = c++
nvcc = $cuda_home/bin/nvcc
cxx_launcher = 
nvcc_launcher = 

common_cflags = -DPy_LIMITED_API=0x03090000 $
    -D_GLIBCXX_USE_CXX11_ABI=1 $
    -I/opt/venv/lib/python3.12/site-packages/flashinfer/data/cccl/cub $
    -I/opt/venv/lib/python3.12/site-packages/flashinfer/data/cccl/libcudacxx/include $
    -I/opt/venv/lib/python3.12/site-packages/flashinfer/data/cccl/thrust $
    -isystem /usr/include/python3.12 $
    -isystem $cuda_home/include $
    -isystem /opt/venv/lib/python3.12/site-packages/tvm_ffi/include $
    -isystem /opt/venv/lib/python3.12/site-packages/tvm_ffi/include $
    -isystem /opt/venv/lib/python3.12/site-packages/flashinfer/data/include $
    -isystem /opt/venv/lib/python3.12/site-packages/flashinfer/data/csrc $
    -isystem /opt/venv/lib/python3.12/site-packages/flashinfer/data/cutlass/include $
    -isystem /opt/venv/lib/python3.12/site-packages/flashinfer/data/cutlass/tools/util/include $
    -isystem /opt/venv/lib/python3.12/site-packages/flashinfer/data/spdlog/include
cflags = $common_cflags $
    -fPIC $
    -std=c++17 $
    -Wno-switch-bool $
    -DNDEBUG $
    -O3
post_cflags =
cuda_cflags = $common_cflags $
    --compiler-options=-fPIC $
    --expt-relaxed-constexpr $
    -static-global-template-stub=false $
    -gencode=arch=compute_90a,code=sm_90a $
    -DFLASHINFER_ENABLE_FP8_E8M0 $
    -DFLASHINFER_ENABLE_FP4_E2M1 $
    -std=c++17 $
    --threads=1 $
    -use_fast_math $
    -Xfatbin=-compress-all $
    -DFLASHINFER_ENABLE_F16 $
    -DFLASHINFER_ENABLE_BF16 $
    -DFLASHINFER_ENABLE_FP8_E4M3 $
    -DFLASHINFER_ENABLE_FP8_E5M2 $
    -DNDEBUG $
    -O3
cuda_post_cflags =
ldflags = -shared $
    -L$cuda_home/lib64 $
    -L$cuda_home/lib64/stubs $
    -lcudart $
    -lcuda

rule compile
  command = $cxx_launcher $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc_launcher $nvcc --generate-dependencies-with-compile -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags
  depfile = $out.d
  deps = gcc

rule link
  command = $cxx $in $ldflags -o $out

build /iopsstor/scratch/cscs/faruk_zahiragic/apertus-spec-decoding-highconc/results/8b/layout-recovery-20261030/controller-v5/runtime/tp2dp2-20261030T131540Z/flashinfer-workspace/.cache/flashinfer/0.6.13/90a/cached_ops/sampling/csrc_sampling.cuda.o: cuda_compile /opt/venv/lib/python3.12/site-packages/flashinfer/data/csrc/sampling.cu
