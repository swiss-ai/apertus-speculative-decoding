+class PaperVerifyScheduler:
+    """DSpark's hardware-aware prefix scheduler as deployed (arXiv:2607.05147,
+    Algorithm 1 with the section 5.2 adaptations).
+
+    Algorithm 1: with ``a[r, j]`` the prefix survival of draft slot ``j`` of
+    request ``r`` (running product of the calibrated per-slot confidences),
+    admit slots in descending ``a`` order; verifying ``K`` of them makes a
+    batch of ``B = R + K`` tokens with ``tau = R + sum of the admitted a``
+    expected tokens, and the throughput is ``Theta = tau * SPS(B)``.
+
+    Section 5.2: the batch capacity ``K`` is chosen from survival two steps
+    old (with async scheduling, the newest drafts the scheduler has seen are
+    those of the step before the one now running), by an unconstrained global
+    search over the whole admission path (no early stop, so jagged SPS cliffs
+    do not trap it); the worker then verifies the ``K`` drafts with the
+    highest current survival (``SchedulerOutput.spec_verify_budget``; a
+    dynamic top-K on the GPU). Every decode request is scheduled with all its
+    draft placeholders, so any split of ``K`` has KV slots.
+
+    ``SPS(B)`` is a cost table profiled once at engine start
+    (VLLM_DSPARK_VERIFY_PROFILE, written by the worker):
+    ``1 / (verify_ms(B) + draft_ms(R))`` for the step's ``R`` requests, the
+    draft step being fixed for the step since DSpark drafts every slot. Up to
+    the largest captured CUDA graph the step replays the graph of the next
+    captured size, so ``verify_ms`` is a step function there.
+
+    As in the paper the objective counts decode tokens only; prefill chunks
+    the engine mixes into the same step are not part of ``B``. Requests whose
+    drafts have no survival yet (first decode step) count at the mean
+    survival per slot of the others.
+    """
+
+    def __init__(self, num_spec_tokens: int, profile_path: str, log_every: int = 500):
+        self.num_spec_tokens = num_spec_tokens
+        self.profile_path = profile_path
+        self.survival: dict[str, np.ndarray] = {}
+        self._table: dict[str, np.ndarray] | None = None
+        self.log_every = log_every
+        self._steps = 0
+        self._sum_budget = 0
+        self._sum_slots = 0
+        self._sum_reqs = 0
+
+    @classmethod
+    def from_env(cls, num_spec_tokens: int) -> "PaperVerifyScheduler":
+        path = os.environ.get("VLLM_DSPARK_VERIFY_PROFILE")
+        if not path:
+            raise ValueError(
+                "VLLM_DSPARK_VERIFY_MODE=paper needs VLLM_DSPARK_VERIFY_PROFILE "
+                "(the cost table; profiled at engine start if the file is missing)"
+            )
+        logger.info(
+            "DSpark confidence-scheduled verification: paper scheduler, "
+            "cost table %s, STS %s",
+            path,
+            os.environ.get("VLLM_DSPARK_STS"),
+        )
+        return cls(num_spec_tokens, path)
+
+    def assign(self, running: list[Request]) -> None:
+        """Nothing is trimmed before scheduling: the split is made on the GPU."""
+
+    def _load_table(self) -> dict[str, np.ndarray]:
+        if self._table is None:
+            with open(self.profile_path) as handle:
+                table = json.load(handle)
+            self._table = {
+                key: np.asarray(table[key], dtype=np.float64)
+                for key in ("verify_tokens", "verify_ms", "draft_reqs", "draft_ms")
+            }
+            self._table["max_capture"] = np.float64(
+                table.get("max_cudagraph_capture_size", 0)
+            )
+        return self._table
+
+    def step_ms(self, num_tokens: np.ndarray, num_reqs: int) -> np.ndarray:
+        """Step time of verifying ``num_tokens`` tokens for ``num_reqs``
+        requests, from the profiled cost table."""
+        table = self._load_table()
+        sizes, verify = table["verify_tokens"], table["verify_ms"]
+        num_tokens = np.asarray(num_tokens, dtype=np.float64)
+        # Captured sizes: the graph of the next captured size runs.
+        index = np.minimum(np.searchsorted(sizes, num_tokens), len(sizes) - 1)
+        ms = verify[index]
+        # Larger steps run without full graphs: interpolate, extrapolate the
+        # last slope.
+        above = num_tokens > table["max_capture"]
+        if above.any():
+            ms = ms.copy()
+            ms[above] = np.interp(num_tokens[above], sizes, verify)
+            beyond = num_tokens > sizes[-1]
+            if beyond.any() and len(sizes) >= 2:
+                slope = (verify[-1] - verify[-2]) / max(sizes[-1] - sizes[-2], 1.0)
+                ms[beyond] = verify[-1] + (num_tokens[beyond] - sizes[-1]) * slope
+        draft = float(np.interp(num_reqs, table["draft_reqs"], table["draft_ms"]))
+        return ms + draft
+
+    def budget(self, scheduled_spec: dict[str, list[int]]) -> int | None:
+        """Batch capacity K for the step: Algorithm 1's admission path over
+        the latest survival the scheduler has, maximised globally."""
+        if not scheduled_spec:
+            return None
+        rows: list[np.ndarray] = []
+        unscored: list[int] = []
+        for req_id, tokens in scheduled_spec.items():
+            row = self.survival.get(req_id)
+            if row is None:
+                unscored.append(len(tokens))
+            else:
+                rows.append(row[: len(tokens)])
+        num_reqs = len(scheduled_spec)
+        num_slots = sum(len(tokens) for tokens in scheduled_spec.values())
+        if not rows:
+            # No estimate at all yet: verify everything.
+            return num_slots
+        if unscored:
+            width = max(len(row) for row in rows)
+            table = np.full((len(rows), width), np.nan)
+            for index, row in enumerate(rows):
+                table[index, : len(row)] = row
+            mean = np.nan_to_num(np.nanmean(table, axis=0), nan=0.0)
+            rows.extend(mean[:length] for length in unscored)
+        survival = np.sort(np.concatenate(rows).astype(np.float64))[::-1]
+        admitted = np.arange(len(survival) + 1)
+        tau = num_reqs + np.concatenate(([0.0], np.cumsum(survival)))
+        # Theta = tau * SPS(B), SPS = 1 / step time.
+        theta = tau / np.maximum(self.step_ms(num_reqs + admitted, num_reqs), 1e-6)
+        budget = int(np.argmax(theta))
+        self._steps += 1
+        self._sum_budget += budget
+        self._sum_slots += num_slots
+        self._sum_reqs += num_reqs
+        if self._steps % self.log_every == 0:
+            logger.info(
+                "DSpark paper scheduler: %.2f of %.2f drafts verified per "
+                "request over %d steps (%.1f decode requests per step)",
+                self._sum_budget / max(self._sum_reqs, 1),
+                self._sum_slots / max(self._sum_reqs, 1),
+                self.log_every,
+                self._sum_reqs / self.log_every,
+            )
+            self._sum_budget = self._sum_slots = self._sum_reqs = 0
+        return budget
+
+    def observe(
+        self, scheduler_output: SchedulerOutput, model_runner_output: ModelRunnerOutput
+    ) -> None:
+        """Keep the newest drafts' survival per request."""
+        survival = model_runner_output.spec_survival
+        if survival is not None:
+            for index, req_id in enumerate(model_runner_output.req_ids):
+                self.survival[req_id] = survival[index]
+        if len(self.survival) > 4 * max(len(model_runner_output.req_ids), 64):
+            live = set(model_runner_output.req_ids)
+            self.survival = {k: v for k, v in self.survival.items() if k in live}
+
+
+class ConfidenceDump:
+    """Calibration data for Sequential Temperature Scaling (DSpark section
+    3.2.1): one JSON line per verification of a request's drafts, with the
+    raw confidence logits of the drafts (``z``), how many were verified
+    (``n``) and how many were accepted (``a``). The drafts' logits arrive
+    with the output of the step that proposed them, their outcome with the
+    next one. Request ids only, no text. A request's last line may be cut by
+    a stop; methods/dspark/scheduler/fit_sts.py drops it."""
+
+    def __init__(self, path: str, num_sampled_tokens_per_step: int) -> None:
+        self.handle = open(path, "a", buffering=1 << 20)
+        self.num_sampled = num_sampled_tokens_per_step
+        self.pending: dict[str, list[float]] = {}
+        logger.info("DSpark confidence calibration data to %s", path)
+
+    def observe(
+        self, scheduler_output: SchedulerOutput, model_runner_output: ModelRunnerOutput
+    ) -> None:
+        logits = model_runner_output.spec_conf_logits
+        verified = model_runner_output.spec_verify_lens
+        sampled = model_runner_output.sampled_token_ids
+        spec = scheduler_output.scheduled_spec_decode_tokens
+        for index, req_id in enumerate(model_runner_output.req_ids):
+            drafts = self.pending.pop(req_id, None)
+            num_verified = len(spec.get(req_id, ()))
+            if verified is not None and num_verified:
+                num_verified = int(verified[index])
+            if drafts is not None and num_verified and sampled and sampled[index]:
+                accepted = min(len(sampled[index]) - self.num_sampled, num_verified)
+                self.handle.write(
+                    json.dumps(
+                        {"req": req_id, "z": drafts, "n": num_verified, "a": accepted}
+                    )
+                    + "\n"
+                )
+            if logits is not None:
+                self.pending[req_id] = [round(float(x), 4) for x in logits[index]]
+        if len(self.pending) > 4 * max(len(model_runner_output.req_ids), 64):
+            live = set(model_runner_output.req_ids)
+            self.pending = {k: v for k, v in self.pending.items() if k in live}
