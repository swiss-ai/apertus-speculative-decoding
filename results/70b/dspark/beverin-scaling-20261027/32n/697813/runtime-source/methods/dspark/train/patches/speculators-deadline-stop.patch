+    def _deadline_reached(self) -> bool:
+        """True on every rank once rank 0's clock passes DSPARK_STOP_AT (unix s).
+
+        Checked every 10 steps; global_step is equal on all ranks, so all ranks
+        take part in the same all-reduce and stop at the same step.
+        """
+        stop_at = os.environ.get("DSPARK_STOP_AT")
+        if not stop_at or self.global_step % 10:
+            return False
+        late = float(self.rank == 0 and time.time() >= float(stop_at))
+        flag = torch.tensor([late], device=torch.cuda.current_device())
+        if self.is_distributed:
+            dist.all_reduce(flag, op=dist.ReduceOp.MAX)
+        return bool(flag.item())
