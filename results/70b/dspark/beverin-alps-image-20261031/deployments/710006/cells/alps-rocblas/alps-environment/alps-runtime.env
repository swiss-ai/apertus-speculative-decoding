# -----------------------------------------------------------------------------
# Helper: set default only if UNSET, then export
# -----------------------------------------------------------------------------
# Usage:
#   defvar VAR "default value"
#
# Semantics:
# - If VAR is unset: set it to the provided default.
# - If VAR is set (even if empty): do not touch it.
# - Always export VAR.
defvar() {
  local name="${1:?var name required}"; shift
  local default="$*"

  # If unset: set it. If set (even empty): keep it.
  if [[ ! ${!name+x} ]]; then
    printf -v "$name" '%s' "$default"
  fi
  export "$name"
}

# -----------------------------------------------------------------------------
# Libfabric / CXI defaults
# -----------------------------------------------------------------------------
# Select the libfabric provider.
defvar FI_PROVIDER "cxi"

# CXI sizing / performance knobs. These variables have been found to give the
# best performance on the Alps network across a wide range of applications.
# Specific applications may perform better with other values.
defvar FI_CXI_DEFAULT_CQ_SIZE "131072"
defvar FI_CXI_DEFAULT_TX_SIZE "16384"

# Disable registration of host buffers (overflow and request) with GPU.
# https://ofiwg.github.io/libfabric/v2.1.0/man/fi_cxi.7.html
defvar FI_CXI_DISABLE_HOST_REGISTER "1"

# Rendezvous settings:
# - Threshold/get-min at 0 enforces the configured rendezvous behavior consistently.
defvar FI_CXI_RDZV_PROTO "alt_read"
defvar FI_CXI_RDZV_EAGER_SIZE "0"
defvar FI_CXI_RDZV_GET_MIN "0"
defvar FI_CXI_RDZV_THRESHOLD "0"

# Message matching begins fully offloaded, if resources become exhausted
# hardware will transition message matching to a hybrid of hardware and
# software matching, see
# https://ofiwg.github.io/libfabric/v2.1.0/man/fi_cxi.7.html.
defvar FI_CXI_RX_MATCH_MODE "hybrid"

# Memory registration cache monitoring method: userfaultfd is required when
# running applications with GPU-aware collectives over libfabric.
defvar FI_MR_CACHE_MONITOR "userfaultfd"

# Specify the maximum size and count of memory regions that can be cached. The
# settings below are used in the HPE Cray Programming Environment (CPE). See,
# https://support.hpe.com/hpesc/public/docDisplay?docId=dp00006843en_us&page=user/memory_cache_monitor_settings.html
defvar FI_MR_CACHE_MAX_SIZE "-1"
defvar FI_MR_CACHE_MAX_COUNT "524288"

# Defines the maximum CPU memcpy size for HMEM device memory that is accessible
# by the CPU with load/store operations.
defvar FI_CXI_SAFE_DEVMEM_COPY_THRESHOLD "16777216"

# -----------------------------------------------------------------------------
# PMIx / OpenMPI defaults
# -----------------------------------------------------------------------------
# PMIX_MCA_psec: PMIx security framework. "Native" is needed to avoid
# warnings about missing security components when running with slurm on Alps.
defvar PMIX_MCA_psec "native"

# The Byte Transfer Layer (BTL) is a framework in Open MPI that is used for
# point-to-point communication. By setting `OMPI_MCA_btl` to
# "^tcp,uct,usnic", we are telling Open MPI to exclude the TCP, UCT, and USNIC
# BTL components from being used for communication.
# More information about `OMPI_MCA_btl` can be found at:
# https://docs.open-mpi.org/en/v5.0.x/mca.html#frameworks
defvar OMPI_MCA_btl "^tcp,uct,usnic"
defvar OMPI_MCA_pml "cm"
defvar OMPI_MCA_mtl "ofi"
defvar OMPI_MCA_opal_common_ofi_provider_include "cxi"
# -----------------------------------------------------------------------------
# NCCL/RCCL-compatible defaults
# -----------------------------------------------------------------------------
# RCCL intentionally supports many NCCL_* runtime variables. Keep only defaults
# here that are expected to apply to both NVIDIA NCCL and AMD RCCL.

# Optional informational markers; will be injected at build time when available.
defvar NCCL_VERSION "${NCCL_VERSION:-}"
defvar AWS_OFI_NCCL_VERSION "${AWS_OFI_NCCL_VERSION:-}"

# This forces NCCL/RCCL-compatible stacks to use the libfabric plugin, enabling
# full use of the Slingshot network. If the plugin can not be found,
# applications will fail to start instead of silently falling back to TCP.
defvar NCCL_NET "AWS Libfabric"

# Use all interfaces that match "hsn" (the prefix of the Slingshot interfaces,
# hsn = high-speed network) for bootstrap/socket communication.
defvar NCCL_SOCKET_IFNAME "hsn"

# Allow the use of different NICs for the same ring/tree. This is suited for
# networks where all NICs from a node are connected to the same switch, like
# Slingshot.
defvar NCCL_CROSS_NIC "0"

# Starting with NCCL 2.27 a new protocol (LL128) was enabled by default, which
# typically performs worse on Slingshot. RCCL also accepts NCCL_PROTO.
defvar NCCL_PROTO "^LL128"

# Number of network channels to be used for pairwise communication.
defvar NCCL_NCHANNELS_PER_NET_PEER "4"

# Number of CPU helper threads used per socket transport network connection.
defvar NCCL_SOCKET_NTHREADS "4"

# Number of sockets opened by each helper thread of the socket transport.
defvar NCCL_NSOCKS_PERTHREAD "1"
# -----------------------------------------------------------------------------
# ROCm / RCCL defaults
# -----------------------------------------------------------------------------
# ROCm/HIP version markers are injected at build time when available.
defvar ROCM_VERSION "${ROCM_VERSION:-}"
defvar RCCL_VERSION "${RCCL_VERSION:-}"

# The ROCm runtime defaults to lazy SDMA reclaim on some platforms. Keep the
# setting explicit for MI300-class collective benchmarks.
defvar HSA_NO_SCRATCH_RECLAIM "1"

# ROCm 10.0 bundled RCCL (2.30.4) is unreliable for 2-node MI300A collectives with P2P
# enabled under enroot on Beverin's current kernel (6.4): RCCL cuMem support needs
# kernel >= 6.8, and the IPC-handle fallback either crashes during communicator setup
# ("HIP failure: invalid device pointer", ~20-30% of launches with one GPU per rank) or
# hangs outright (multi-GPU-per-rank). Only NCCL_NET=Socket (no aws-ofi-rccl
# registration) or disabling P2P avoids it; no RCCL knob (nvlink-centric scheduler,
# read-enable, forced cuMem, HMEM or dmabuf disable) helps. Same failure class as the
# rocm7.14 variant.
#
# Users can still override by exporting NCCL_P2P_DISABLE (any value, including empty)
# before the runtime env loads; defvar semantics keep pre-set values untouched.
defvar NCCL_P2P_DISABLE "1"
