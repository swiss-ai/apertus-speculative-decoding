export ROCM_PYTHON=/opt/venv/bin/python
export ROCM_SDK=/opt/venv/bin/rocm-sdk
export ROCM_SDK_ROOT=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core
export ROCM_SDK_BIN=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core/bin
export ROCM_SDK_CMAKE=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core/lib/cmake
export ROCM_CORE_DIR=/opt/venv/lib/python3.12/site-packages
export ROCM_CORE_PREFIX=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core
export ROCM_LIBRARIES_DIR=/opt/venv/lib/python3.12/site-packages
export ROCM_LIBRARIES_PREFIX=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_libraries
export ROCM_DEVEL_DIR=''
export ROCM_DEVEL_PREFIX=''
export ROCM_BUILD_PREFIX=/opt/rocm
export RCCL_PREFIX=/opt/alps/rocm/rccl-bundled
export RCCL_INCLUDE_DIR=/opt/alps/rocm/rccl-bundled/include
export RCCL_LIB_DIR=/opt/alps/rocm/rccl-bundled/lib
